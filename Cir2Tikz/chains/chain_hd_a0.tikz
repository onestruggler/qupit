\draw (n0y-62.center) to (n0y-62t.center);
\fill [white] (n0y-63ftl.center) rectangle (n0y-63fbr.center);
\draw (n0y-63bl.center) to (n0y-63tr.center);
\draw (n0y-63tl.center) to (n0y-63br.center);
