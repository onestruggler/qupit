\draw (lm0el10.center) to (lm0er10.center);
\end{pgfonlayer}
\node [style=none,rotate=-90] (equiv) at (3.125, -1.75) {$=$};
\begin{pgfonlayer}{nodelayer}
\node [style=gate] (n0y-60) at (1.75, -5.5) {$H$};
\node [style=gate] (n0y-61) at (4.25, -5.5) {$H$};
\node [style=cnot ctrl, label={above:${-a}$}] (n0y-62) at (6.75, -3.5) {};
\node [style=cnot ctrl] (n0y-62t) at (6.75, -5.5) {$$};
\node [style=none] (n0y-63tl) at (8.5, -3.5) {$$};
\node [style=none] (n0y-63bl) at (8.5, -5.5) {$$};
\node [style=none] (n0y-63br) at (10.0, -5.5) {$$};
\node [style=none] (n0y-63tr) at (10.0, -3.5) {$$};
\node [style=none] (n0y-63ftl) at (8.5, -3.35) {};
\node [style=none] (n0y-63fbr) at (10.0, -5.65) {};
\node [style=none] (lm0el0-6) at (0.0, -5.5){};
\node [style=none] (lm0el1-6) at (0.0, -3.5){};
\node [style=none] (lm0er0-6) at (11.0, -5.5){};
\node [style=none] (lm0er1-6) at (11.0, -3.5){};
