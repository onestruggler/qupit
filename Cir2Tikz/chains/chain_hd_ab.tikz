\begin{tikzpicture}
\begin{pgfonlayer}{nodelayer}
\node [style=gate] (n0y00) at (1.75, 0.0) {$H$};
\node [style=D box] (n0y01) at (4.5, 1.0) {$D_{{ab}}$};
\node [style=none] (lm0el00) at (0.0, 0.0){};
