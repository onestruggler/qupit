\draw (lm0el10.center) to (lm0er10.center);
\end{pgfonlayer}
\node [style=none,rotate=-90] (equiv) at (3.125, -1.75) {$=$};
\begin{pgfonlayer}{nodelayer}
\node [style=gate] (n0y-60) at (1.75, -5.5) {$H$};
\node [style=gate] (n0y-61) at (4.75, -5.5) {$S^{{-b/a}}$};
\node [style=gate] (n0y-62) at (7.75, -5.5) {$H$};
\node [style=cnot ctrl, label={above:${-a}$}] (n0y-63) at (10.25, -3.5) {};
\node [style=cnot ctrl] (n0y-63t) at (10.25, -5.5) {$$};
\node [style=none] (n0y-64tl) at (12.0, -3.5) {$$};
\node [style=none] (n0y-64bl) at (12.0, -5.5) {$$};
