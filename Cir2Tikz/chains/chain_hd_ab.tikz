\draw (lm0el0-6.center) to (lm0er0-6.center);
\draw (lm0el1-6.center) to (lm0er1-6.center);
\draw (n0y-63.center) to (n0y-63t.center);
\fill [white] (n0y-64ftl.center) rectangle (n0y-64fbr.center);
\draw (n0y-64bl.center) to (n0y-64tr.center);
\draw (n0y-64tl.center) to (n0y-64br.center);
\end{pgfonlayer}
\node [style=none,rotate=-90] (equiv) at (7.25, -7.25) {$\equiv_s$};
\begin{pgfonlayer}{nodelayer}
